+    def _restickify_read_is_core_local(
+        self, graph: GraphLowering, name: str, reader: Operation
+    ) -> bool:
+        """Whether ``reader`` consumes exactly ``name``'s same-core slice.
+
+        torch-spyre#4153's proof, minus the relayout-plan branch: with no plans
+        (the cpsat path) it reduces to producer-write-view == restickify-read-view.
+        """
+        reads = [
+            dep
+            for dep in op_read_writes(reader).reads
+            if isinstance(dep, MemoryDep) and dep.name == name
+        ]
+        if len(reads) != 1 or reads[0].is_indirect():
+            _restickify_logger.debug(
+                f"restickify proof {name}: {len(reads)} matching reads -> fail"
+            )
+            return False
+        read_view, partial, representable = _per_core_view_on_buf(
+            reader, reads[0], name
+        )
+        if partial or not representable:
+            _restickify_logger.debug(
+                f"restickify proof {name}: read view partial={partial} "
+                f"representable={representable} -> fail"
+            )
+            return False
+
+        producer = next((op for op in graph.operations if op.get_name() == name), None)
+        if not isinstance(producer, ComputedBuffer):
+            _restickify_logger.debug(
+                f"restickify proof {name}: producer is not a ComputedBuffer -> fail"
+            )
+            return False
+        writes = [
+            dep
+            for dep in op_read_writes(producer).writes
+            if isinstance(dep, MemoryDep) and dep.name == name
+        ]
+        if len(writes) != 1 or writes[0].is_indirect():
+            _restickify_logger.debug(
+                f"restickify proof {name}: write dep unusable -> fail"
+            )
+            return False
+        write_view, write_partial, write_representable = _per_core_view_on_buf(
+            producer, writes[0], name
+        )
+        ok = (
+            not write_partial
+            and write_representable
+            and per_core_views_equal(write_view, read_view)
+        )
+        _restickify_logger.debug(
+            f"restickify proof {name}: write {write_view} vs read {read_view} -> "
+            f"{'PASS' if ok else 'FAIL'}"
+        )
+        return ok
 
